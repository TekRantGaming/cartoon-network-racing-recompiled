+    bool IopRpcBridge::deliverSifCommand(const uint8_t *packet, uint32_t size, IopGuestExecutor &executor)
+    {
+        constexpr uint32_t kMaxPacketSize = 128u;
+        if (!packet || size < 16u || size > kMaxPacketSize)
+            return false;
+        uint32_t cid = 0u;
+        std::memcpy(&cid, packet + 8u, sizeof(cid));
+
+        // System command SIF_CMD_SET_SREG (payload: u32 index, u32 value), handled by sifcmd itself. Cartoon Network
+        // Racing's IOPMAIN.IRX polls sceSifGetSreg until the EE sets its register.
+        if (cid == 0x80000001u && size >= 24u)
+        {
+            uint32_t index = 0u, value = 0u;
+            std::memcpy(&index, packet + 16u, sizeof(index));
+            std::memcpy(&value, packet + 20u, sizeof(value));
+            if (index < m_sregs.size())
+                m_sregs[index] = value;
+            return true;
+        }
+
+        CmdHandler handler;
+        if (const auto it = m_cmdHandlers.find(cid); it != m_cmdHandlers.end())
+            handler = it->second;
+        else if ((cid & 0x80000000u) == 0u && m_userCmdTable != 0u && cid < m_userCmdTableSize)
+        {
+            handler.function = m_memory.read32(m_userCmdTable + cid * 8u);
+            handler.data = m_memory.read32(m_userCmdTable + cid * 8u + 4u);
+            handler.gp = m_userCmdTableGp;
+        }
+        if (handler.function == 0u)
+            return false;
+
+        if (m_cmdReceiveBuffer == 0u)
+            m_cmdReceiveBuffer = m_memory.allocate(kMaxPacketSize, 16u);
+        if (m_cmdReceiveBuffer == 0u || !m_memory.writeRam(m_cmdReceiveBuffer, packet, size))
+            return false;
+        if (iopSyncTraceLevel() >= 2)
+        {
+            uint32_t header[4] = {}, words[4] = {};
+            std::memcpy(header, packet, sizeof(header));
+            std::memcpy(words, packet + 16u, std::min<uint32_t>(16u, size - 16u));
+            std::fprintf(stderr, "[iop-sync] EE cmd cid=0x%x size=%u hdr=%08x %08x opt=%08x -> handler 0x%x data=0x%x: %08x %08x %08x %08x\n",
+                         cid, size, header[0], header[1], header[3], handler.function, handler.data, words[0], words[1],
+                         words[2], words[3]);
+            if ((header[0] >> 8) != 0u && m_memory.ownsRamRange(header[1], 64u))
+            {
