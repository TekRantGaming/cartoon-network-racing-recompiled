+                (void)m_memory.readRam(header[1], extra, sizeof(extra));
+                std::string text;
+                for (uint8_t c : extra)
+                    text += (c >= 0x20 && c < 0x7F) ? static_cast<char>(c) : '.';
+                uint32_t ew[12] = {};
+                std::memcpy(ew, extra, sizeof(ew));
+                std::fprintf(stderr, "[iop-sync]   extra @%x: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x |%s|\n",
+                             header[1], ew[0], ew[1], ew[2], ew[3], ew[4], ew[5], ew[6], ew[7], ew[8], ew[9], ew[10], ew[11],
+                             text.c_str());
+            }
+        }
+        // Handlers run in the SIF DMA interrupt on real hardware: synchronously, outside any IOP thread.
