+// The processor has AVX2 and Windows saves its registers. From CPUID: Windows' own check only knows it on newer builds.
+bool HasAvx2() {
+#if defined(_MSC_VER)
+  int r[4] = {};
+  __cpuid(r, 0);
+  if (r[0] < 7) return false;
+  __cpuid(r, 1);
+  const int kOsxsave = 1 << 27, kAvx = 1 << 28;
+  if ((r[2] & kOsxsave) == 0 || (r[2] & kAvx) == 0) return false;
+  if ((_xgetbv(0) & 6) != 6) return false;
+  __cpuidex(r, 7, 0);
+  return (r[1] & (1 << 5)) != 0;
+#else
+  return true;
+#endif
+}
