+void StartPs2DiscInstall(const GameInfo& game, const std::string& image, GameJobs& jobs) {
+  if (jobs.task.running()) return;
+  jobs.kind = GameJobs::Kind::kInstall;
+  jobs.message.clear();
+  jobs.message_is_error = false;
+  const std::string out_dir = GameDataDir(game);
+  const std::string want = game.disc_serial;
+  const std::string title = game.title;
+  const std::string marker = game.installed_file;
+  const uint64_t limit = game.disc_file_limit;
+  jobs.task.Start("Checking the disc image", [image, out_dir, want, title, marker, limit](trg::Task& task) -> std::string {
+    const std::string got = trg::ReadPs2Serial(image);
+    if (got.empty())
+      return "That file is not a PlayStation 2 disc image. Choose the .iso file you made from your " + title + " disc.";
+    if (got != want) {
+      for (const GameInfo& other : Games())
+        if (other.disc_serial && got == other.disc_serial)
+          return "That is the disc of " + std::string(other.title) + ", not " + title + ". Choose the " + title +
+                 " disc image.";
+      return "That is a PlayStation 2 disc of another game (" + got + "), not " + title + ". Choose the " + title +
+             " disc image.";
+    }
+    const std::string staging = out_dir + ".part";
+    std::error_code ec;
+    fs::remove_all(fs::u8path(staging), ec);
+    fs::create_directories(fs::u8path(staging), ec);
+    task.SetLabel("Copying the game's files from your disc image");
+    std::string err = trg::ExtractPs2Disc(task, image, staging, limit);
+    if (!err.empty() || task.cancelled()) {
+      fs::remove_all(fs::u8path(staging), ec);
+      return err;
+    }
+    if (!fs::exists(fs::u8path(staging + "/" + marker), ec)) {
+      fs::remove_all(fs::u8path(staging), ec);
+      return "The disc image was read, but " + marker + " was not on it. The image may be damaged.";
+    }
+    // The game reads most of the disc by sector, so it keeps the whole image. On the same drive a link does that
+    // without a second copy, and the image stays when the original is moved or deleted.
+    fs::create_hard_link(fs::u8path(image), fs::u8path(staging + "/disc.iso"), ec);
+    if (ec) {
+      task.SetLabel("Copying your disc image. This takes a few minutes.");
+      err = trg::CopyFileJob(task, image, staging + "/disc.iso");
+      if (!err.empty() || task.cancelled()) {
+        fs::remove_all(fs::u8path(staging), ec);
+        return err;
+      }
+    }
+    fs::remove_all(fs::u8path(out_dir), ec);
+    fs::rename(fs::u8path(staging), fs::u8path(out_dir), ec);
+    if (ec) return "The files were copied, but the game folder could not be finished: " + ec.message();
+    return std::string();
+  });
+}
