+// One row of a game's own settings (GameInfo::settings). Make them with the functions below. Each row's value is
+// written to the game's settings file, and every row's default too before the first Play, so the game reads what the
+// launcher shows.
+struct SettingOption {
+  const char* value;
+  const char* label;
+};
+
+struct SettingRow {
+  enum class Kind { kHeading, kParagraph, kChoice, kToggle, kSlider, kResolution, kKey };
+  Kind kind = Kind::kHeading;
+  const char* label = "";
+  const char* help = "";
+  const char* key = "";  // the setting's name in the game's settings file
+  const char* def = "";  // its default: an option's value, "true"/"false", a number, or the key names ("Z,Return")
+  std::vector<SettingOption> options;
+  int min = 0, max = 100, step = 1;
+  const char* format = "%d";
+  // Shown only while the setting `show_key` has the value `show_value` (the row's default is still written).
+  const char* show_key = nullptr;
+  const char* show_value = nullptr;
+
+  SettingRow When(const char* other_key, const char* value) const {
+    SettingRow r = *this;
+    r.show_key = other_key;
+    r.show_value = value;
+    return r;
+  }
+};
+
+inline SettingRow HeadingRow(const char* text) {
+  SettingRow r;
+  r.label = text;
+  return r;
+}
+inline SettingRow ParagraphRow(const char* text) {
+  SettingRow r;
+  r.kind = SettingRow::Kind::kParagraph;
+  r.label = text;
+  return r;
+}
+inline SettingRow ChoiceRow(const char* label, const char* help, const char* key, const char* def,
+                            std::vector<SettingOption> options) {
+  SettingRow r;
+  r.kind = SettingRow::Kind::kChoice;
+  r.label = label;
+  r.help = help;
+  r.key = key;
+  r.def = def;
+  r.options = std::move(options);
+  return r;
+}
+inline SettingRow ToggleRow(const char* label, const char* help, const char* key, bool def) {
+  SettingRow r;
+  r.kind = SettingRow::Kind::kToggle;
+  r.label = label;
+  r.help = help;
+  r.key = key;
+  r.def = def ? "true" : "false";
+  return r;
+}
+inline SettingRow SliderRow(const char* label, const char* help, const char* key, const char* def, int min, int max,
+                            int step, const char* format) {
+  SettingRow r;
+  r.kind = SettingRow::Kind::kSlider;
+  r.label = label;
+  r.help = help;
+  r.key = key;
+  r.def = def;
+  r.min = min;
+  r.max = max;
+  r.step = step;
+  r.format = format;
+  return r;
+}
+// Your screen, 1280 x 720 ... 3840 x 2160, 1920 x 1080 by default, written as window_width and window_height (0 for
+// Your screen): the size the game draws at and shows, and the size of its window when windowed.
+inline SettingRow ResolutionRow(const char* help) {
+  SettingRow r;
+  r.kind = SettingRow::Kind::kResolution;
+  r.label = "Resolution";
+  r.help = help;
+  return r;
+}
+// A key the player can change. `def` is one key name or several with commas; the names are ReXGlue's (Z, Return,
+// Left, Numpad0, LMB ...) plus LShift, RShift, LCtrl, RCtrl, LAlt and RAlt.
+inline SettingRow KeyRow(const char* label, const char* key, const char* def) {
+  SettingRow r;
+  r.kind = SettingRow::Kind::kKey;
+  r.label = label;
+  r.key = key;
+  r.def = def;
+  return r;
+}
+
+// A section of a game's own settings (Display, Graphics ...).
+struct SettingsSection {
+  const char* name;
+  std::vector<SettingRow> rows;
 };
 
