+// PlayStation 2 disc images (ISO 9660), for "install from your own disc" pages.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace trg {
+
+class Task;
+
+// The disc's serial from the BOOT2 line of its SYSTEM.CNF ("SLUS_214.38"), or "" when the file is not a PlayStation 2
+// disc image (.iso with 2048 byte sectors).
+std::string ReadPs2Serial(const std::string& utf8_image);
+
+// Copies the disc's files of at most `max_file_bytes` into `out_dir`, keeping its folders, on a Task, reporting progress
+// in bytes and honouring Cancel. Names lose the ";1" version ending. Larger files stay in the image: most PlayStation 2
+// games read those by sector. Returns "" on success, else an error message.
+std::string ExtractPs2Disc(Task& task, const std::string& utf8_image, const std::string& utf8_out_dir,
+                           uint64_t max_file_bytes);
+
+}  // namespace trg
