+void WriteSettingDefaults(trg::SettingsStore& st, const GameInfo& game) {
+  bool changed = false;
+  for (const SettingsSection& section : game.settings) {
+    for (const SettingRow& row : section.rows) {
+      if (row.kind == SettingRow::Kind::kResolution) {
+        if (st.Get("window_height").empty()) {
+          st.SetInt("window_width", 1920);
+          st.SetInt("window_height", 1080);
+          changed = true;
+        }
+      } else if (*row.key && st.Get(row.key).empty()) {
+        st.Set(row.key, row.def);
+        changed = true;
+      }
+    }
+  }
+  if (changed) st.Save();
+}
