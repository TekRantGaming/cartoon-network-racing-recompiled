--- /dev/null
+++ b/src/ps2.cpp
@@ -0,0 +1,149 @@
+#include "trg/ps2.h"
+
+#include <algorithm>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+#include "trg/platform.h"
+#include "utf8_path.h"
+
+namespace trg {
+namespace {
+
+namespace fs = std::filesystem;
+
+constexpr uint64_t kSector = 2048;
+constexpr int kMaxDepth = 16;
+
+using detail::Utf8Path;
+
+uint32_t Le32(const unsigned char* p) {
+  return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+
+struct Entry {
+  std::string path;  // "MODULES/IOPMAIN.IRX"
+  uint32_t sector = 0, size = 0;
+};
+
+class Disc {
+ public:
+  explicit Disc(const std::string& path) {
+    f_.open(Utf8Path(path), std::ios::binary);
+    unsigned char pvd[kSector];
+    if (!Read(16, pvd, kSector) || pvd[0] != 1 || std::memcmp(pvd + 1, "CD001", 5) != 0) return;
+    root_sector_ = Le32(pvd + 156 + 2);
+    root_size_ = Le32(pvd + 156 + 10);
+    ok_ = root_sector_ != 0 && root_size_ != 0;
+  }
+  bool ok() const { return ok_; }
+
+  bool Read(uint64_t sector, void* out, size_t size) {
+    f_.clear();
+    f_.seekg(std::streamoff(sector * kSector));
+    f_.read(static_cast<char*>(out), std::streamsize(size));
+    return size_t(f_.gcount()) == size;
+  }
+
+  // Every file on the disc, walking from the root directory.
+  void List(std::vector<Entry>& out) { Walk(root_sector_, root_size_, "", 0, out); }
+
+  std::string ReadFile(const Entry& e) {
+    std::string s(e.size, '\0');
+    return Read(e.sector, s.data(), e.size) ? s : std::string();
+  }
+
+ private:
+  void Walk(uint32_t sector, uint32_t size, const std::string& prefix, int depth, std::vector<Entry>& out) {
+    if (depth > kMaxDepth || size > (64u << 20)) return;
+    std::vector<unsigned char> d(size);
+    if (!Read(sector, d.data(), size)) return;
+    for (size_t i = 0; i + 33 < size;) {
+      const size_t len = d[i];
+      if (len == 0) {  // records never cross a sector: the rest of this one is empty
+        i = (i / kSector + 1) * kSector;
+        continue;
+      }
+      if (i + len > size) break;
+      const unsigned char* r = d.data() + i;
+      i += len;
+      const size_t name_len = r[32];
+      if (33 + name_len > len) continue;
+      std::string name(reinterpret_cast<const char*>(r + 33), name_len);
+      if (name_len == 1 && (name[0] == 0 || name[0] == 1)) continue;  // . and ..
+      if (const size_t semi = name.find(';'); semi != std::string::npos) name.resize(semi);
+      if (name.empty() || name == "." || name == "..") continue;
+      bool safe = true;
+      for (unsigned char c : name) safe = safe && c >= 0x20 && c != '/' && c != '\\' && c != ':';
+      if (!safe) continue;
+      const uint32_t extent = Le32(r + 2), bytes = Le32(r + 10);
+      if (r[25] & 2)
+        Walk(extent, bytes, prefix + name + "/", depth + 1, out);
+      else
+        out.push_back({prefix + name, extent, bytes});
+    }
+  }
+
+  std::ifstream f_;
+  uint32_t root_sector_ = 0, root_size_ = 0;
+  bool ok_ = false;
+};
+
+}  // namespace
+
+std::string ReadPs2Serial(const std::string& utf8_image) {
+  Disc disc(utf8_image);
+  if (!disc.ok()) return {};
+  std::vector<Entry> files;
+  disc.List(files);
+  for (const Entry& e : files) {
+    if (e.path != "SYSTEM.CNF" || e.size > 4096) continue;
+    const std::string cnf = disc.ReadFile(e);
+    const size_t boot = cnf.find("BOOT2");
+    if (boot == std::string::npos) return {};
+    const size_t slash = cnf.find('\\', boot);
+    if (slash == std::string::npos) return {};
+    std::string serial;
+    for (size_t i = slash + 1; i < cnf.size() && cnf[i] != ';' && cnf[i] != '\r' && cnf[i] != '\n'; ++i)
+      serial += cnf[i];
+    return serial;
+  }
+  return {};
+}
+
+std::string ExtractPs2Disc(Task& task, const std::string& utf8_image, const std::string& utf8_out_dir,
+                           uint64_t max_file_bytes) {
+  Disc disc(utf8_image);
+  if (!disc.ok()) return "That file is not a PlayStation 2 disc image.";
+  std::vector<Entry> files;
+  disc.List(files);
+  long long total = 0, done = 0;
+  for (const Entry& e : files)
+    if (e.size <= max_file_bytes) total += e.size;
+  std::vector<char> buf(1 << 20);
+  for (const Entry& e : files) {
+    if (e.size > max_file_bytes) continue;
+    if (task.cancelled()) return {};
+    const fs::path to = Utf8Path(utf8_out_dir) / Utf8Path(e.path);
+    std::error_code ec;
+    fs::create_directories(to.parent_path(), ec);
+    std::ofstream out(to, std::ios::binary | std::ios::trunc);
+    if (!out) return "Cannot write to the game folder.";
+    uint64_t sector = e.sector;
+    for (uint64_t left = e.size; left > 0;) {
+      const size_t n = size_t(std::min<uint64_t>(left, buf.size()));
+      if (!disc.Read(sector, buf.data(), n)) return "The disc image could not be read. It may be damaged.";
+      out.write(buf.data(), std::streamsize(n));
+      if (!out) return "Writing failed: is the disk full?";
+      sector += n / kSector;
+      left -= n;
+      done += (long long)n;
+      task.Progress(done, total);
+    }
+  }
+  return {};
+}
+
+}  // namespace trg
