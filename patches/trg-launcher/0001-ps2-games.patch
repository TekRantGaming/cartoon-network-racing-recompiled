+// ------------------------------------------------------ a game's own rows ---
+// Key names for a game's own key rows (KeyRow): ReXGlue's, plus the modifier keys.
+std::string OwnKeyName(ImGuiKey k) {
+  switch (k) {
+    case ImGuiKey_LeftShift: return "LShift";
+    case ImGuiKey_RightShift: return "RShift";
+    case ImGuiKey_LeftCtrl: return "LCtrl";
+    case ImGuiKey_RightCtrl: return "RCtrl";
+    case ImGuiKey_LeftAlt: return "LAlt";
+    case ImGuiKey_RightAlt: return "RAlt";
+    default: return KeyName(k);
+  }
+}
+
+void DrawOwnRow(Rows& r, trg::SettingsStore& st, const SettingsSection& section, const SettingRow& row) {
+  if (row.show_key) {
+    std::string_view def;  // the other row's default: nothing is written before the first Play
+    for (const SettingRow& other : section.rows)
+      if (std::string_view(other.key) == row.show_key) def = other.def;
+    if (st.Get(row.show_key, def) != row.show_value) return;
+  }
+  switch (row.kind) {
+    case SettingRow::Kind::kHeading: r.Heading(row.label); break;
+    case SettingRow::Kind::kParagraph: r.Paragraph(row.label); break;
+    case SettingRow::Kind::kToggle: r.Toggle(row.label, row.help, row.key, std::string_view(row.def) == "true"); break;
+    case SettingRow::Kind::kSlider:
+      r.SliderInt(row.label, row.help, row.key, std::atoi(row.def), row.min, row.max, row.step, row.format);
+      break;
+    case SettingRow::Kind::kChoice: {
+      std::vector<Option> options;
+      for (const SettingOption& o : row.options) options.push_back({o.value, o.label});
+      r.Choice(row.label, row.help, row.key, row.def, options);
+      break;
+    }
+    case SettingRow::Kind::kResolution: {
+      static const int sizes[][2] = {{0, 0}, {1280, 720}, {1920, 1080}, {2560, 1440}, {3840, 2160}};
+      static const std::vector<std::string> names = {"Your screen", "1280 \xC3\x97 720", "1920 \xC3\x97 1080",
+                                                     "2560 \xC3\x97 1440", "3840 \xC3\x97 2160"};
+      const int w = st.GetInt("window_width", 1920), h = st.GetInt("window_height", 1080);
+      int cur = -1;
+      for (int i = 0; i < int(std::size(sizes)); ++i)
+        if (sizes[i][0] == w && sizes[i][1] == h) cur = i;
+      if (r.ChoiceIndex(row.label, row.help, cur, names, 2) && cur >= 0) {
+        st.SetInt("window_width", sizes[cur][0]);
+        st.SetInt("window_height", sizes[cur][1]);
+        st.Save();
+      }
+      break;
+    }
+    case SettingRow::Kind::kKey:
+      if (r.KeyBind(row.label, Pretty(st.Get(row.key, row.def)))) {
+        const char* key = row.key;
+        trg::SettingsStore* store = &st;
+        CaptureKey(row.label, [store, key](ImGuiKey k) {
+          const std::string name = OwnKeyName(k);
+          if (name.empty()) return false;
+          store->Set(key, name);
+          store->Save();
+          return true;
+        });
+      }
+      break;
+  }
+}
